# Copy this file to .env and fill in your API keys.
# .env is gitignored.

# OpenAI API (used by Mem0/HippoRAG/A-MEM upstream packages for extraction,
# and by experiments/crag-7-ranking-shift/llm_judge*.py for gpt-4o-mini judge)
OPENAI_API_KEY=sk-your-key-here

# Anthropic API (used by experiments/crag-7-ranking-shift/llm_judge_cross.py
# and experiments/crag-9-faithful-repro/llm_judge_faithful_vs_cellj.py
# for Claude-Sonnet-4.5 cross-family judge)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: HuggingFace token if loading gated models (e.g., Llama-3.1-8B)
# HF_TOKEN=hf_your-token-here

# Optional: paths for cached HF model downloads (default: ~/.cache/huggingface/hub)
# HF_HOME=/path/to/hf/cache
# TRANSFORMERS_CACHE=/path/to/hf/cache
